{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OrderCreatedEvent",
  "description": "Wiadomosc RabbitMQ order.created odbierana z order-service.",
  "type": "object",
  "required": ["order_id", "restaurant_id", "items", "total_price"],
  "additionalProperties": false,
  "properties": {
    "order_id": {
      "type": "integer",
      "minimum": 1
    },
    "restaurant_id": {
      "type": "integer",
      "minimum": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["menu_item_id", "name", "quantity", "unit_price", "notes"],
        "additionalProperties": false,
        "properties": {
          "menu_item_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unit_price": {
            "type": ["string", "number"],
            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_price": {
      "type": ["string", "number"],
      "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
    }
  }
}
