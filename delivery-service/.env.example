# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production-please
# DEBUG defaults to True — set to False in production
DEBUG=True
ALLOWED_HOSTS=*

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=deliveries
POSTGRES_USER=postgres
POSTGRES_PASSWORD=super_secret_password

# ── OpenRouteService ─────────────────────────────────────────────────────────
# Get your free API key at: https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your_ors_api_key_here

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
# Leave empty to disable event publishing (safe for local testing).
# The service will log a debug message and continue normally without it.
# Example: amqp://guest:guest@rabbitmq:5672/
RABBITMQ_URL=

# ── Admin superuser (created automatically on first run) ─────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change_this_password

# ── App ───────────────────────────────────────────────────────────────────────
APP_PORT=8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
