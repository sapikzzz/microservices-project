{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "OrderCreate",
  "description": "Walidacja danych wejściowych przy składaniu zamówienia (POST /api/orders/).",
  "type": "object",
  "required": ["restaurant_id", "delivery_address", "items"],
  "additionalProperties": false,
  "properties": {
    "restaurant_id": {
      "type": "integer",
      "minimum": 1
    },
    "restaurant_name": {
      "type": "string",
      "maxLength": 200
    },
    "delivery_address": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["menu_item_id", "name", "unit_price", "quantity"],
        "additionalProperties": false,
        "properties": {
          "menu_item_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "unit_price": {
            "type": ["string", "number"],
            "pattern": "^[0-9]+(\\.[0-9]{1,2})?$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
